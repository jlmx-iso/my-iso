# Copy to `.dev.vars` for `npm run dev:wrangler` (the built Worker running
# locally under wrangler). `.dev.vars` is gitignored; never commit real values.
#
# These are the RUNTIME variables: the server-side names in src/env.js
# (src/env.test.ts fails when they drift). In staging and production the
# same names are set with `wrangler secret put` or in wrangler.toml `[vars]`;
# see docs/DEPLOYMENT.md.
#
# Not here, on purpose:
# - NEXT_PUBLIC_*: inlined at build time from `.env`, not read at runtime.
# - DATABASE_URL: the Worker uses the D1 binding from wrangler.toml.
# - NODE_ENV: set in wrangler.toml.

# Overrides the "production" in wrangler.toml while developing.
APP_ENV=development
# Content-Security-Policy: "enforce" (default) or "report-only" (kill switch:
# block nothing, only report). See docs/DEPLOYMENT.md.
CSP_MODE=

# ---- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32
AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Resend) ----------------------------------------------------------
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
# Where Pro support requests go; defaults to NEXT_PUBLIC_SUPPORT_EMAIL.
SUPPORT_INBOX_EMAIL=

# ---- Images (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_STANDARD_ANNUAL_PRICE_ID=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_ANNUAL_PRICE_ID=
# Test runs only: a local stand-in for the Stripe API (loopback addresses only;
# refused in a production deployment). Leave empty otherwise.
STRIPE_API_BASE_URL=

# ---- Google Places -----------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---- PostHog -----------------------------------------------------------------
# Override the region set in wrangler.toml, or point at a local stub.
POSTHOG_HOST=
POSTHOG_ASSETS_HOST=
# Account deletion: the PostHog person and events (person:write key, project id).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ---- AI (Anthropic) ----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
