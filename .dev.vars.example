# ==============================================================================
# CLOUDFLARE WORKERS/PAGES LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ==============================================================================
#
# This file is for local Cloudflare Workers/Pages development with Wrangler
# Copy this file to `.dev.vars` and populate with your actual values
#
# DO NOT commit .dev.vars to version control (it's gitignored)
# This .dev.vars.example file shows what variables are needed
#
# Usage: `npx wrangler pages dev` automatically loads .dev.vars
#
# Note: D1 database binding is configured in wrangler.toml, not here
# ==============================================================================

# ==============================================================================
# AUTHENTICATION - Auth.js v5
# ==============================================================================

# REQUIRED: Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_RUN_openssl_rand_base64_32
AUTH_URL=http://localhost:8788

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# EMAIL - Resend
# ==============================================================================

EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# ==============================================================================
# CLOUDINARY - Image Management
# ==============================================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# SUPABASE - File Storage
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# STRIPE - Payment Processing
# ==============================================================================

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# CRITICAL: Required for webhook security. While it is empty the webhook
# answers 500 to every delivery.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ids (price_...) of the four recurring prices of the Pro
# product, from the Stripe dashboard (Product catalogue -> the Pro product ->
# each price -> "Copy price ID"). REQUIRED for checkout. See docs/BILLING.md.
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_ANNUAL_PRICE_ID=
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_STANDARD_ANNUAL_PRICE_ID=

# TEST ONLY: a local stand-in for the Stripe API. Loopback addresses only;
# refused in a production deployment. Leave unset otherwise.
# STRIPE_API_BASE_URL=http://127.0.0.1:12111

# ==============================================================================
# GOOGLE MAPS / PLACES API
# ==============================================================================

GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# ==============================================================================
# ANALYTICS - PostHog
# ==============================================================================

NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_PUBLIC_KEY=

# ==============================================================================
# APPLICATION
# ==============================================================================

BASE_URL=http://localhost:8788
NODE_ENV=development

# ==============================================================================
# SENTRY - Error Reporting (optional)
# ==============================================================================

# Sentry is off unless a DSN is set. Leave empty for local development.
SENTRY_DSN=
