# Build-time configuration for one deployment. Copy to `.env.deploy.staging`
# and `.env.deploy.production` (both gitignored) and fill in; `npm run
# deploy:staging` / `deploy:production` load the matching file
# (scripts/deploy.mjs).
#
# Only values that are inlined into the JavaScript at build time belong here:
# the NEXT_PUBLIC_* variables of src/env.js. They are public by nature (they
# ship to every browser). Runtime configuration and secrets are set on the
# Worker instead: docs/DEPLOYMENT.md.
#
# NEXT_PUBLIC_APP_ENV is set by the deploy script from the environment name.

# The https origin this deployment is served on, e.g. https://myiso.app
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe publishable key (pk_live_... for production, pk_test_... for staging).
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Google Maps JavaScript / Places key, restricted to this deployment's origin.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# PostHog project token (phc_...). One project per environment, or one
# project filtered by the `environment` property. Empty switches PostHog off.
NEXT_PUBLIC_POSTHOG_PUBLIC_KEY=
# Only for PostHog EU: https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=

# ---- Not part of the app: source map upload for error tracking ---------------
# When both are set, a deploy generates browser source maps, uploads them to
# PostHog and removes them from the deployed assets (scripts/sourcemaps.mjs).
# Personal API key with "error tracking: write" and "organization: read".
POSTHOG_CLI_API_KEY=
# Numeric project id (PostHog > Project settings).
POSTHOG_CLI_PROJECT_ID=
# Only for PostHog EU: https://eu.posthog.com
POSTHOG_CLI_HOST=
