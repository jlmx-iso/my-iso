# Copy to `.env` for local development (`npm run dev`).
# `.env` is gitignored; never commit real values.
#
# Deployments do not use `.env`: their build-time values come from
# `.env.deploy.<environment>` (see .env.deploy.example) and everything else
# is set on the Worker.
#
# This file lists exactly the variables in src/env.js, with the same names
# (src/env.test.ts fails when they drift). docs/DEPLOYMENT.md explains each
# one: what it is for, where to get it, and how it is set in staging and
# production.
#
# NEXT_PUBLIC_* values are inlined into the JavaScript at build time.
# Everything else is read at runtime.

# ---- App ---------------------------------------------------------------------
NODE_ENV="development"
# production | staging | development. Tags analytics; reported by /api/health.
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
# The app's public origin: the one source of truth for absolute URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Address shown to people who need help. Defaults to support@myiso.app.
NEXT_PUBLIC_SUPPORT_EMAIL=""
# Content-Security-Policy: "enforce" (default) or "report-only" (kill switch:
# block nothing, only report). Read at runtime.
CSP_MODE=""

# ---- Database ----------------------------------------------------------------
# SQLite file for `next dev`. Unused on Cloudflare (D1 binding in wrangler.toml).
DATABASE_URL="file:./db.sqlite"

# ---- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_RUN_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Test runs only: a local OpenID provider standing in for Google sign-in (the
# end-to-end stub, src/test/helpers/oidcStub.ts). Accepted only when it points
# at this machine (localhost / loopback); ignored and reported in a production
# deployment. Never set it on a deployment. See docs/DEPLOYMENT.md.
GOOGLE_OAUTH_ISSUER_URL=""

# ---- Email (Resend) ----------------------------------------------------------
# Sender of every transactional email. Without RESEND_API_KEY nothing is sent.
EMAIL_FROM="noreply@example.com"
RESEND_API_KEY=""
# Where Pro members' in-app support requests go. Defaults to
# NEXT_PUBLIC_SUPPORT_EMAIL, then support@myiso.app.
SUPPORT_INBOX_EMAIL=""

# ---- Images (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Payments (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STANDARD_MONTHLY_PRICE_ID=""
STRIPE_STANDARD_ANNUAL_PRICE_ID=""
STRIPE_FOUNDING_MONTHLY_PRICE_ID=""
STRIPE_FOUNDING_ANNUAL_PRICE_ID=""
# Test runs only: a local stand-in for the Stripe API (the stub in
# src/test/helpers/stripeStub.ts, or stripe-mock). Accepted only when it
# points at this machine (localhost / loopback) and refused outright in a
# production deployment. Never set it on a deployment. See docs/BILLING.md.
STRIPE_API_BASE_URL=""

# ---- Google Places -----------------------------------------------------------
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# ---- Analytics, replay, flags, error tracking (PostHog) ----------------------
# Project token (phc_...). Leave empty to switch all of it off.
NEXT_PUBLIC_POSTHOG_PUBLIC_KEY=""
# Region. Defaults are US Cloud; for EU use https://eu.posthog.com,
# https://eu.i.posthog.com and https://eu-assets.i.posthog.com.
NEXT_PUBLIC_POSTHOG_UI_HOST=""
POSTHOG_HOST=""
POSTHOG_ASSETS_HOST=""
# Account deletion also deletes the member's PostHog person and events. A
# personal API key with only the person:write scope, and the project id
# (numeric). Empty = that step is skipped and reported.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""

# ---- AI (Anthropic) ----------------------------------------------------------
# Without a key, match summaries and icebreakers are switched off.
ANTHROPIC_API_KEY=""
# Optional overrides: model id (default claude-haiku-5-5) and API origin.
ANTHROPIC_MODEL=""
ANTHROPIC_BASE_URL=""
