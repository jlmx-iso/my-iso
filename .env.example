# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# ==============================================================================
# DATABASE
# ==============================================================================

# Prisma Database URL
# Local development: Use SQLite with LibSQL adapter
# Production: Use D1 (set via wrangler.toml, this can be omitted)
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="file:./db.sqlite"

# ==============================================================================
# AUTHENTICATION - Auth.js v5
# ==============================================================================

# REQUIRED: Generate a new secret with: openssl rand -base64 32
# This is used for JWT encryption - must be at least 32 characters
# https://authjs.dev/getting-started/deployment#environment-variables
AUTH_SECRET="CHANGE_ME_RUN_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# Google OAuth
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ==============================================================================
# EMAIL - Resend
# ==============================================================================

# Email sending service
# Sign up: https://resend.com
# Get API key from dashboard
# OPTIONAL: If not set, email features will not work
EMAIL_FROM="noreply@example.com"
RESEND_API_KEY=""

# ==============================================================================
# CLOUDINARY - Image Management
# ==============================================================================

# Cloudinary for image uploads and transformations
# Sign up: https://cloudinary.com
# Get credentials from dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================================================================
# STRIPE - Payment Processing
# ==============================================================================

# Stripe for payments
# Sign up: https://stripe.com
# Get keys from dashboard (use test keys for development)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# Webhook secret for signature verification
# Get from Stripe Dashboard -> Webhooks -> Add endpoint
# CRITICAL: Required for webhook security. While it is empty the webhook
# answers 500 to every delivery (Stripe keeps retrying).
STRIPE_WEBHOOK_SECRET=""

# Stripe Price ids (price_...) of the four recurring prices of the Pro
# product. Copy them from the Stripe dashboard: Product catalogue -> the Pro
# product -> each price -> "Copy price ID". Test mode and live mode have
# different ids. REQUIRED for checkout: a plan whose id is missing cannot be
# bought (checkout answers "billing unavailable"). See docs/BILLING.md.
#   founding = founding members, founders and ambassadors; standard = everyone else
STRIPE_FOUNDING_MONTHLY_PRICE_ID=""
STRIPE_FOUNDING_ANNUAL_PRICE_ID=""
STRIPE_STANDARD_MONTHLY_PRICE_ID=""
STRIPE_STANDARD_ANNUAL_PRICE_ID=""

# TEST ONLY. Sends Stripe API calls to a local stand-in (the stub in
# src/test/helpers/stripeStub.ts, or stripe-mock). Only loopback addresses
# (localhost, 127.0.0.1, [::1]) are accepted, and it is refused outright in
# a production deployment (a live key, or a public base URL that is not this
# machine). Leave it unset everywhere else.
# STRIPE_API_BASE_URL="http://127.0.0.1:12111"

# ==============================================================================
# GOOGLE MAPS / PLACES API
# ==============================================================================

# Google Places API for location features
# Enable API: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# ==============================================================================
# ANALYTICS - PostHog
# ==============================================================================

# PostHog for product analytics
# Sign up: https://posthog.com
# Get credentials from project settings
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_POSTHOG_PUBLIC_KEY=""
# your posthog project api key
POSTHOG_API_KEY=""

# ==============================================================================
# APPLICATION
# ==============================================================================

# Base URL for the application
# Development: http://localhost:3000
# Production: Your domain
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# ==============================================================================
# SENTRY - Error Reporting (optional)
# ==============================================================================

# Sentry is off unless a DSN is set. Leave both empty for local development.
# SENTRY_DSN is read by the server and edge runtimes, NEXT_PUBLIC_SENTRY_DSN is
# inlined into the browser bundle at build time.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
