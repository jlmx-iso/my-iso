{
  "name": "my-iso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "node scripts/with-dev-env.mjs next dev",
    "dev:wrangler": "node scripts/with-dev-env.mjs npm run build:cf && wrangler dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "postbuild:cf": "node scripts/sourcemaps.mjs",
    "check:bundle": "node scripts/check-worker-bundle.mjs",
    "start": "node scripts/with-dev-env.mjs next start",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "jobs:local": "node scripts/run-scheduled.mjs",
    "typegen": "node scripts/with-dev-env.mjs next typegen",
    "prelint": "npm run typegen",
    "lint": "eslint .",
    "pretypecheck": "npm run typegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "coverage:diff": "node scripts/diff-coverage.mjs",
    "coverage:guard": "node scripts/coverage-guard.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:push": "prisma generate && prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:check": "node scripts/db-migrations.mjs check",
    "db:migrate:diff": "node scripts/db-migrations.mjs diff",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:upgrade-legacy": "node scripts/db-upgrade-legacy.mjs",
    "db:seed:local": "wrangler d1 execute DB --local --file=prisma/seed-staging.sql",
    "db:seed:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/seed-staging.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@mantine/core": "9.8.0",
    "@mantine/dates": "9.8.0",
    "@mantine/dropzone": "9.8.0",
    "@mantine/form": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/render": "^2.3.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.0",
    "@trpc/react-query": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "dayjs": "^1.11.23",
    "jose": "^6.2.17",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "posthog-js": "^1.447.15",
    "posthog-node": "^5.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-email": "^6.11.11",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@playwright/test": "^1.65.0",
    "@posthog/cli": "^0.19.4",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-libsql": "^7.10.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "@react-email/render": "$@react-email/render",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.8"
    }
  },
  "allowScripts": {
    "@posthog/cli": true,
    "@prisma/engines": true,
    "better-sqlite3": true,
    "core-js": false,
    "esbuild": true,
    "fsevents": false,
    "prisma": true,
    "workerd": true
  }
}
