{
  "name": "my-iso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:wrangler": "npm run build:cf && wrangler dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "check:bundle": "node scripts/check-worker-bundle.mjs",
    "start": "next start",
    "deploy:staging": "npm run build:cf && wrangler deploy --env staging",
    "deploy:production": "npm run build:cf && wrangler deploy --env=\"\"",
    "typegen": "next typegen",
    "prelint": "npm run typegen",
    "lint": "eslint .",
    "pretypecheck": "npm run typegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:push": "prisma generate && prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:seed:staging": "wrangler d1 execute DB --remote --env staging --file=prisma/seed-staging.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@mantine/core": "8.3.18",
    "@mantine/dates": "8.3.18",
    "@mantine/dropzone": "8.3.18",
    "@mantine/form": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@sentry/nextjs": "^10.32.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.0",
    "@trpc/react-query": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "cookie-light": "^0.0.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^12.34.0",
    "jose": "^6.2.17",
    "mantine-form-zod-resolver": "^1.3.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "posthog-js": "^1.447.12",
    "posthog-node": "^5.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^5.5.6",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "stripe": "^14.25.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-libsql": "^7.10.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "glob": "^11.0.0",
    "@react-email/render": "$@react-email/render"
  }
}
