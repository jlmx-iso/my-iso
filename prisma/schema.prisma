// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Example {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  password          String?
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// One row per user: the Stripe subscription that currently decides their
// access (see src/server/_billing). Written only by the functions in
// src/server/_billing/subscriptionStore.ts, always from a subscription object
// fetched from Stripe.
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Stripe subscription id (sub_...). Null only on rows from before billing
  // state was mirrored from Stripe.
  subscriptionId     String?
  stripeCustomerId   String?
  // Mirrors Stripe's subscription.status: trialing, active, past_due,
  // canceled, unpaid, incomplete, incomplete_expired, paused.
  status             String    @default("incomplete")
  // Stripe price id of the plan item, which configured plan it is
  // ("founding" | "standard", null for a price this app does not know) and
  // its billing interval ("month" | "year").
  priceId            String?
  plan               String?
  interval           String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // The subscription is set to end (cancel_at_period_end or cancel_at), and
  // when.
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelAt           DateTime?
  endedAt            DateTime?
  // Stripe's cancellation_details.reason once canceled.
  cancellationReason String?
  // When Stripe created the subscription, and Stripe's clock when the state
  // above was read from its API. A write carrying an older reading never
  // replaces a newer one.
  stripeCreatedAt    DateTime?
  stripeSyncedAt     DateTime?
  // The subscription's latest invoice (in_...), and the end of the current
  // period when that invoice is paid (null when it is not): a cancelled
  // subscription keeps access only for a period that was paid for.
  latestInvoiceId    String?
  paidThroughAt      DateTime?
  // When the subscription first turned past_due; kept while it stays
  // past_due (also across new billing periods) and cleared when it leaves
  // that status. The grace window is counted from here.
  pastDueSince       DateTime?
  // The payment standing, derived from Stripe as a whole each time (see
  // src/server/_billing/paymentStanding.ts), never updated per event: the
  // dispute that withholds access (dp_...), "open" | "lost" ("lost": the
  // last paid invoice was taken back and none has been paid since), and
  // the invoice its charge paid. All null when nothing is withheld.
  disputeId          String?
  disputeStatus      String?
  disputeInvoiceId   String?
  // The latest invoice, when its payment was refunded in full (same source).
  refundedInvoiceId  String?
  // When the payment standing was last derived completely and recorded.
  // Null: never, or the last derivation was incomplete. A row is settled
  // only when both this and stripeSyncedAt are set.
  standingSyncedAt   DateTime?
  // A comped account: Pro without a Stripe subscription. Set by hand.
  isLifetime         Boolean

  // DEPRECATED legacy flags, still written (derived from `status`) so that
  // the previously deployed release keeps working during a deploy or a
  // rollback, and because they are NOT NULL without a default: keep writing
  // them until they have one. Removal order: docs/DATABASE.md.
  isTrial            Boolean
  isActive           Boolean
  isCanceled         Boolean
  isPaused           Boolean
  isPending          Boolean
  isExpired          Boolean
  expiresAt          DateTime?
  user               User      @relation(fields: userId, references: id, onDelete: Cascade)
}

// Every dispute (chargeback or inquiry) the app has learned of, by Stripe
// subscription id (sub_...). Never deleted: a dispute that is not finished
// is re-read from Stripe by its id whenever the payment standing is derived,
// so one on a charge too old for the charge listing cannot be forgotten.
// `status`: "open" | "inquiry" | "lost" | "superseded" | "cleared" (see
// src/server/_billing/paymentStanding.ts). The disputeId/disputeStatus/
// disputeInvoiceId columns on Subscription are the summary derived from
// this set, so that an access check needs no join.
model SubscriptionDispute {
  disputeId      String   @id
  subscriptionId String
  // The invoice the disputed charge paid.
  invoiceId      String
  status         String
  updatedAt      DateTime

  @@index([subscriptionId, status])
}

// Stripe webhook events this app has taken on (see
// src/server/_billing/webhook.ts). `id` is the Stripe event id (evt_...),
// which is what makes a repeated delivery a no-op. Times are Unix seconds.
model StripeEvent {
  id           String @id
  type         String
  // "processing" while a delivery is being handled, then "processed".
  status       String
  // event.created
  eventCreated Int
  claimedAt    Int
  processedAt  Int?

  @@index([claimedAt])
}

// Short leases that serialise billing work per user (starting Checkout);
// see src/server/_billing/lease.ts. `expiresAt` is Unix seconds: a lease
// whose holder died is taken over after that.
model BillingLease {
  key       String @id
  holder    String
  expiresAt Int
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Photographer {
  id              String           @id @default(cuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String           @unique
  name            String
  location        String
  bio             String?
  avatar          String?
  website         String?
  instagram       String?
  facebook        String?
  twitter         String?
  youtube         String?
  tiktok          String?
  vimeo           String?
  portfolioImages PortfolioImage[]
  reviews         Review[]
  companyName     String
  events          Event[]

  // Search performance indexes
  @@index([name])
  @@index([location])
  // Note: bio field uses LIKE/contains queries which can't be fully optimized with standard indexes
  // For production scale, consider:
  // 1. Full-text search (FTS5 for SQLite/D1)
  // 2. External search service (Algolia, Meilisearch, Typesense)
  // 3. Limit search to indexed fields only
  @@index([companyName])
}

model PortfolioImage {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  photographerId String
  image          String
  title          String
  description    String?
  tags           String // JSON-serialized array for SQLite compatibility
  isFeatured     Boolean
  isDeleted      Boolean      @default(false)
  sortOrder      Int          @default(0)

  @@index([photographerId, isDeleted])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId  String

  @@unique([userId, targetId])
  @@index([targetId])
}

model Review {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  photographerId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  rating         Int
  title          String
  description    String?

  // One review per reviewer per photographer. (Also the index for "reviews
  // of this photographer": photographerId is its first column.)
  @@unique([photographerId, userId])
}

model MessageThread {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Sorted participant ids joined with ":" (see threadParticipantKey). Unique,
  // so that one participant set has exactly one thread. Null only on threads
  // created before the column existed; they are keyed on first use.
  participantKey String?   @unique
  participants   User[]
  messages       Message[]
  match          Match?
  reads          ThreadRead[]
}

// Per-participant read state: `userId` has seen everything in the thread up
// to the place (lastReadAt, lastReadMessageId). No row means nothing has
// been read.
model ThreadRead {
  threadId   String
  userId     String
  lastReadAt DateTime
  // With lastReadAt, the place read up to in (createdAt, id) order: the
  // message that was seen. Null: everything sent at lastReadAt.
  lastReadMessageId String?
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  // DEPRECATED, never read or written: read state lives in ThreadRead. Kept
  // until the release that still selects it is gone; drop it in a later
  // migration.
  isRead    Boolean       @default(false)
  isDeleted Boolean       @default(false)

  // NOTE: migrations/0003 also creates the trigger "Message_touch_thread" on
  // this table: it sets MessageThread.updatedAt to the new message's
  // createdAt in the same statement as the insert. Prisma does not know
  // about triggers; a migration that rebuilds this table drops the trigger
  // and must create it again (message.test.ts fails if it is missing).
  @@index([threadId, createdAt])
}

model User {
  id                String             @id @default(cuid())
  firstName         String
  lastName          String
  handle            String?            @unique
  email             String             @unique
  emailVerified     DateTime?
  profilePic        String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  country           String?
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  photographer      Photographer?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  favorites         Favorite[]
  reviews           Review[]
  messages          Message[]
  messageThreads    MessageThread[]
  threadReads       ThreadRead[]
  comments          Comment[]
  stripeId          String?            @unique
  commentLikes      CommentLike[]
  eventLike         EventLike[]
  bookingsApplied   Booking[]          @relation("BookingApplicant")
  bookingsOwned     Booking[]          @relation("BookingOwner")
  notifications     Notification[]
  role              String             @default("standard")
  invitedByUserId   String?
  invitedBy         User?              @relation("InvitedByUser", fields: [invitedByUserId], references: [id])
  invitees          User[]             @relation("InvitedByUser")
  inviteCode        InviteCode?
  inviteRedemptions InviteRedemption[]
  waitlistReviews   Waitlist[]         @relation("WaitlistReviewer")
  swipesSent        Swipe[]            @relation("SwipesSent")
  swipesReceived    Swipe[]            @relation("SwipesReceived")
  matchesAsUser1    Match[]            @relation("MatchesAsUser1")
  matchesAsUser2    Match[]            @relation("MatchesAsUser2")
  isDiscoverable    Boolean            @default(false)
  seekingTypes      String? // JSON array: ["wedding", "portrait", "event", "commercial"]
  budgetMin         Int?
  budgetMax         Int?
  profileViews      ProfileView[]

  // The Discover deck and recipient search filter on it.
  @@index([isDiscoverable])
}

model Event {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  photographerId String
  title          String
  description    String?
  location       String
  date           DateTime
  duration       Int          @default(1) // In hours
  image          String?
  // LEGACY, neither read nor written: whether an event is filled is
  // derived from its bookings (withDerivedFulfilled). Kept until a drop
  // migration; see docs/DATABASE.md.
  isFulfilled    Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  comments       Comment[]
  eventLikes     EventLike[]
  bookings       Booking[]
  views          EventView[]
  // Note: description field uses LIKE/contains queries which can't be fully optimized with standard indexes
  // For production scale, consider full-text search (FTS5) or external search service

  // Search performance indexes
  @@index([title])
  @@index([location])
  @@index([isDeleted, date]) // Feeds and search: live events by date
  @@index([photographerId, isDeleted, date]) // One photographer's events by date
}

model EventLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted Boolean  @default(false)

  @@unique([eventId, userId])
}

model Comment {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  isDeleted    Boolean       @default(false)
  commentLikes CommentLike[]

  @@index([eventId, isDeleted])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDeleted Boolean  @default(false)

  // commentId is the first column, so this also serves "likes of a comment".
  @@unique([commentId, userId])
}

model Booking {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  applicant   User     @relation("BookingApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId String
  owner       User     @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  status      String   @default("applied") // applied, accepted, declined, completed, canceled
  rate        String? // Proposed rate
  notes       String? // Message from applicant
  ownerNotes  String? // Response from event owner
  // How a canceled booking ended: "withdrawn" (the applicant took back an
  // application), "canceled_by_applicant" or "canceled_by_owner" (an
  // accepted booking was called off). Only a withdrawal can be followed by a
  // new application. Null on other statuses and on rows canceled before the
  // column existed.
  cancelOrigin String?
  isDeleted   Boolean  @default(false)

  // Also the index for "bookings of this event" (eventId comes first).
  @@unique([eventId, applicantId])
  @@index([applicantId, status])
  @@index([ownerId, status])
}

model Notification {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type        String // booking_applied, booking_accepted, booking_declined, booking_canceled, booking_completed, new_message, review_received, profile_view
  title       String
  body        String
  isRead      Boolean  @default(false)
  linkUrl     String? // Deep link to relevant page
  data        String? // JSON-serialized extra data

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}

model InviteCode {
  id                 String             @id @default(cuid())
  code               String             @unique
  creatorId          String             @unique
  creator            User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  maxRedemptions     Int                @default(5)
  currentRedemptions Int                @default(0)
  // How many redemptions were ever recorded for this code. Raised by the
  // trigger "InviteRedemption_count" (migrations/0004) in the same statement
  // that inserts the redemption, and never lowered: a used invite stays
  // used, also after the invited member's account (and with it the
  // redemption row) is deleted.
  redeemedCount      Int                @default(0)
  // Set when a slot is claimed or released, cleared by the reconcile job
  // once it has checked `currentRedemptions` against `redeemedCount`: the
  // queue of codes to check (src/server/_jobs/reconcileInviteSlots.ts).
  slotsChangedAt     DateTime?
  createdAt          DateTime           @default(now())
  regeneratedAt      DateTime?
  redemptions        InviteRedemption[]

  @@index([slotsChangedAt])
}

model InviteRedemption {
  id           String     @id @default(cuid())
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  redeemedById String
  redeemedBy   User       @relation(fields: [redeemedById], references: [id], onDelete: Cascade)
  redeemedAt   DateTime   @default(now())

  // A user is invited at most once.
  @@unique([redeemedById])
  @@index([inviteCodeId])
}

model Waitlist {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  instagram      String?
  website        String?
  userType       String    @default("both") // lead, second, both
  referralSource String?
  status         String    @default("pending") // pending, approved, rejected
  position       Int?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?     @relation("WaitlistReviewer", fields: [reviewedById], references: [id])
  convertedAt    DateTime?

  @@index([status, createdAt])
}

model PendingInviteValidation {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Email sign-in codes (identifier = "otp:<email>"), see
// src/server/_db/verificationToken.ts. A 6-digit code is only unique per
// identifier, so `token` is deliberately not unique on its own. (The table
// keeps its Auth.js name and shape; no Auth.js email provider uses it.)
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  // Failed + successful verification attempts made against this code. The
  // code stops being accepted once this passes OTP_MAX_ATTEMPTS.
  attempts   Int      @default(0)

  @@unique([identifier, token])
  @@index([expires])
}

// Fixed-window rate limit counters (see src/server/_utils/rateLimit.ts).
// `key` is "<bucket>:<keyed hash of the client identifier>"; `windowStart`
// and `expiresAt` are Unix seconds.
model RateLimit {
  key         String
  windowStart Int
  count       Int
  expiresAt   Int

  @@id([key, windowStart])
  @@index([expiresAt])
}

model Swipe {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  swiperId  String
  targetId  String
  direction String // "like" | "pass"
  swiper    User     @relation("SwipesSent", fields: [swiperId], references: [id], onDelete: Cascade)
  target    User     @relation("SwipesReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId, direction])
}

model Match {
  id                     String         @id @default(cuid())
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user1Id                String
  user2Id                String
  status                 String         @default("matched") // matched, messaged, booked, expired
  messageThreadId        String?        @unique
  aiSummary              String?
  // Conversation starters written once per match: a JSON array of strings
  // (see src/server/_lib/matchInsights.ts). Null until generated.
  icebreakers            String?
  // When generation was last started; bounds retries and concurrent runs.
  icebreakersRequestedAt DateTime?
  expiresAt              DateTime?
  user1                  User           @relation("MatchesAsUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2                  User           @relation("MatchesAsUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messageThread          MessageThread? @relation(fields: [messageThreadId], references: [id])

  @@unique([user1Id, user2Id])
  @@index([user1Id, status])
  @@index([user2Id, status])
  // Expiry sweep and read-time expiry: "matched" rows whose expiresAt has
  // passed. Created by migrations/0003.
  @@index([status, expiresAt])
}

// Profile views for Pro insights: one row per (profile owner, UTC day,
// source) holding a count, raised by an atomic upsert
// (src/server/_lib/viewCounter.ts). Deliberately no viewer column: who looked
// is never stored. Self-views and obvious bots are not counted. `day` is
// "YYYY-MM-DD" (UTC); `source` is one of VIEW_SOURCES (search, event, ...),
// derived from the referring path on this site, never the full URL.
model ProfileView {
  userId String
  day    String
  source String
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, source])
  // "When did counting start" (the earliest day) without a scan.
  @@index([day])
}

// Event page views for Pro insights, as ProfileView: one row per (event, UTC
// day) with a count; no viewer is stored. The owner's own views are not
// counted.
model EventView {
  eventId String
  day     String
  count   Int    @default(0)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day])
  @@index([day])
}

// Which signed-in members were already counted today for a profile or event
// (src/server/_lib/viewCounter.ts), so a member counts once a day per target
// on any device. `key` is an HMAC (AUTH_SECRET) of viewer, target and day:
// opaque, it can confirm a guess with the secret but never list who looked.
// Rows of past days are deleted by the purge-expired job.
model ViewSeen {
  key String @id
  day String

  @@index([day])
}
